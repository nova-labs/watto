<hr>


<div class="row g-5">
  <div class="col">
    <div class="card">
      <div class="card-header py-3 d-flex align-items-center">
        <img src="<%= gravatar_url(current_user) %>" class="rounded-circle align-self-start me-3" style="height:60px;width:60px;background-color:grey;">
        <div>
          <h5 class="card-title mb-0">
            <%= [
              "Howdy,",
              "Hello,",
              "Hi,",
              "How do,",
              "Greetings,",
              "Look everybody! It's"
            ].sample %>
          <%= current_user.first_name %>
          </h5>
          <h6 class="card-subtitle text-muted"><%= current_user.email %></h6>
        </div>
      </div>
      <div class="card-body">
        <p class="card-text">
        Nova Labs Automations is a lil web interface for maker
        space tool sign-offs and membership managements. Data is
        pulled from the Wild Apricot Member portal.
        </p>
      </div>
      <ul class="list-group list-group-flush">
        <% if current_user.account_administrator? %>
          <li class="list-group-item">
            😱 You are an account administrator. Be careful.
          </li>
        <% end %>
        <% if current_user.admin? %>
          <li class="list-group-item">
            🎉 You are an admin, congrats!
          </li>
        <% end %>
        <% if current_user.signoffer? %>
          <li class="list-group-item">
            💪 You have the super powers for signing people off.
          </li>
        <% end %>
      </ul>
    </div>

    &nbsp;

    <div class="row g-2">
      <div class="col">
        <%= link_to waitlist_index_path, class: "card action-card text-center text-decoration-none text-muted py-3" do %>
          <div><i class="fas fa-list-alt fa-2x text-warning"></i></div>
          <small>The Waitlist</small>
        <% end %>
      </div>
      <div class="col">
        <%= link_to events_path, class: "card action-card text-center text-decoration-none text-muted py-3" do %>
          <div><i class="fas fa-calendar-alt fa-2x text-primary"></i></div>
          <small>All Events</small>
        <% end %>
      </div>
      <div class="col">
        <%= link_to user_path(current_user), class: "card action-card text-center text-decoration-none text-muted py-3" do %>
          <div><i class="fas fa-user-circle fa-2x text-info"></i></div>
          <small>Your Profile</small>
        <% end %>
      </div>
    </div>

    &nbsp;

    <div class="card">
      <div class="card-header py-3">Classes You're Taking</div>
      <% taking = current_user.attending_events.recent_and_upcoming %>
      <% if taking.any? %>
        <ul class="list-group list-group-flush">
          <% taking.each do |event| %>
            <li class="list-group-item">
              <%= link_to event.name, event_path(event) %>
              <span class="float-end">
                <%= display_date event.start_date %>
                <% if event.start_date.to_date < Date.current %>
                  <span class="badge bg-secondary ms-2">Past</span>
                <% end %>
              </span>
            </li>
          <% end %>
        </ul>
      <% else %>
        <div class="card-body">No recent or upcoming classes</div>
      <% end %>
    </div>

    <% teaching = current_user.teaching_events.recent_and_upcoming %>
    <% if teaching.any? %>
      &nbsp;
      <div class="card">
        <div class="card-header py-3">Classes You're Teaching</div>
        <ul class="list-group list-group-flush">
          <% teaching.each do |event| %>
            <li class="list-group-item">
              <%= link_to event.name, event_path(event) %>
              <span class="float-end">
                <%= display_date event.start_date %>
                <% if event.start_date.to_date < Date.current %>
                  <span class="badge bg-secondary ms-2">Past</span>
                <% end %>
              </span>
            </li>
          <% end %>
        </ul>
      </div>
    <% end %>

  </div>
  <div class="col-md">
    <h3>Your Sign-offs and Categories</h3>
    <table class="table">
      <tbody>
        <% current_user.field_values.signoffs.each do |field_value| %>
          <tr>
            <td scope="row">
              <%= user_field_value_badge(field_value) %>
            </td>
            <td class="w-100">
              <% if field_value.novapass? %>
                <span class="badge badge-novapass">NovaPass</span>
              <% end %>
              <%= field_value.name %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

