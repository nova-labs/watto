[Unit]
Description=Watto Rails App
After=network.target

[Service]
User=wautils
Group=wautils
WorkingDirectory=/home/wautils/srv/watto
EnvironmentFile=/home/wautils/srv/watto/.env
# Only Apache needs to reach Puma, so keep it off the public interface.
ExecStart=/home/wautils/srv/watto/bin/bundle exec rails server -b 127.0.0.1 -p $PORT

Restart=always
RestartSec=14s
SyslogIdentifier=%n
KillMode=mixed
TimeoutStopSec=5

[Install]
WantedBy=multi-user.target
